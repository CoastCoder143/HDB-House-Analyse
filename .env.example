# Onemap API Configuration
# 
# To use this file:
# 1. Register for a free Onemap API account at: https://www.onemap.gov.sg/apidocs/register
# 2. Copy this file to .env (the script will read from environment variables)
# 3. Fill in your credentials below
# 4. IMPORTANT: Add .env to .gitignore to avoid committing credentials

# Your Onemap API credentials
ONEMAP_EMAIL=your_email@example.com
ONEMAP_PASSWORD=your_password_here

# Usage:
# On Linux/Mac: source .env or export variables manually
# On Windows: set variables using 'set ONEMAP_EMAIL=...' or use a .env loader

# Alternative: Set environment variables directly
# Linux/Mac:
#   export ONEMAP_EMAIL='your_email@example.com'
#   export ONEMAP_PASSWORD='your_password'
#
# Windows (CMD):
#   set ONEMAP_EMAIL=your_email@example.com
#   set ONEMAP_PASSWORD=your_password
#
# Windows (PowerShell):
#   $env:ONEMAP_EMAIL='your_email@example.com'
#   $env:ONEMAP_PASSWORD='your_password'
